# HDFC SmartGateway UAT configuration
HDFC_BASE_URL=https://smartgateway.hdfcuat.bank.in
HDFC_MERCHANT_ID=SG6695

# Required: enter the actual API key issued in the merchant dashboard.
# Basic Auth is generated as Base64(API_KEY + ":"); password is empty.
HDFC_API_KEY=

# HDFC UAT payment page client ID.
HDFC_PAYMENT_PAGE_CLIENT_ID=hdfcmaster

# Required to verify signed return parameters. Enter the full response key locally.
# Do not use the masked value from chat.
HDFC_RESPONSE_KEY=

# Must be a public HTTPS URL reachable by HDFC. No query string and no redirects.
HDFC_RETURN_URL=https://YOUR-PUBLIC-DOMAIN.example/api/payments/return

# Optional integration settings
HDFC_ENABLE_LOGGING=false
HDFC_TIMEOUT_SECONDS=30
