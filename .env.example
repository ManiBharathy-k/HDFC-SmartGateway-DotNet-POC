# HDFC SmartGateway sandbox only. Fill values from the merchant's HDFC onboarding pack.
HDFC_BASE_URL=https://REPLACE-WITH-OFFICIAL-SANDBOX-HOST
HDFC_BASIC_AUTH_USERNAME=REPLACE_WITH_HDFC_BASIC_AUTH_USERNAME
HDFC_BASIC_AUTH_PASSWORD=REPLACE_WITH_HDFC_SANDBOX_PASSWORD

# Set these only if the selected HDFC API requires a separate merchant header.
HDFC_MERCHANT_ID=
HDFC_MERCHANT_HEADER_NAME=

# Exact paths from the HDFC Basic Authentication API reference.
HDFC_CREATE_ORDER_PATH=/REPLACE_WITH_CREATE_ORDER_PATH
HDFC_ORDER_STATUS_PATH_TEMPLATE=/REPLACE_WITH_STATUS_PATH/{orderId}

# Optional
HDFC_TIMEOUT_SECONDS=30
