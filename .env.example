# HDFC SmartGateway UAT configuration
HDFC_BASE_URL=https://smartgateway.hdfcuat.bank.in
HDFC_MERCHANT_ID=SG6695

# Required for server-to-server HDFC API authentication.
HDFC_API_KEY=

# UAT payment page client ID
HDFC_PAYMENT_PAGE_CLIENT_ID=hdfcmaster

# Optional while testing session creation and order status.
# Required only when HDFC signed return verification is enabled.
HDFC_RESPONSE_KEY=

# Set true only after obtaining the complete response key and confirming
# HDFC's signed-return configuration for this merchant.
HDFC_VERIFY_RETURN_SIGNATURE=false

# Public HTTPS callback URL. Localhost is not reachable by HDFC.
HDFC_RETURN_URL=https://YOUR-PUBLIC-DOMAIN.example/api/payments/return

HDFC_ENABLE_LOGGING=false
HDFC_TIMEOUT_SECONDS=30
