@model HDFCSmartGateway.Models.StatusModel
<h1>Check HDFC order status</h1>
@using(Html.BeginForm()){ @Html.AntiForgeryToken() @Html.ValidationSummary()
<label>Order ID</label>@Html.TextBoxFor(x=>x.OrderId)
<label>Customer / routing ID</label>@Html.TextBoxFor(x=>x.CustomerId)
<button type="submit">Fetch status from HDFC</button> }