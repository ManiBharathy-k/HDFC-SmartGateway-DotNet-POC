@model HDFCSmartGateway.Models.CreatePaymentModel
<h1>Create HDFC UAT payment</h1>
@using(Html.BeginForm()){ @Html.AntiForgeryToken() @Html.ValidationSummary()
<label>Order ID</label>@Html.TextBoxFor(x=>x.OrderId)
<label>Amount INR</label>@Html.TextBoxFor(x=>x.Amount)
<label>Customer ID</label>@Html.TextBoxFor(x=>x.CustomerId)
<label>Email</label>@Html.TextBoxFor(x=>x.CustomerEmail)
<label>Phone</label>@Html.TextBoxFor(x=>x.CustomerPhone)
<label>First name</label>@Html.TextBoxFor(x=>x.FirstName)
<label>Last name</label>@Html.TextBoxFor(x=>x.LastName)
<label>Description</label>@Html.TextBoxFor(x=>x.Description)
<label>Public HTTPS return URL</label>@Html.TextBoxFor(x=>x.ReturnUrl)
<button type="submit">Create HDFC session</button> }